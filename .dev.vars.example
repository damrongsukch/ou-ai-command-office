APP_MODE=local-development

# Configure at least one AI provider for local Nova chat.
OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=replace_me_optional
OPENAI_MODEL=gpt-5-nano

# Telegram is optional for local development.
TELEGRAM_BOT_TOKEN=replace_me_optional
TELEGRAM_ALLOWED_CHAT_ID=replace_me_optional
TELEGRAM_WEBHOOK_SECRET=replace_me_optional

# Optional D1 binding is configured in Cloudflare, not as a local secret value.
